<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Arducam ToF camera on the turret. The board and its envelope are in
       the turret mesh, so these are frames only:
       tof_camera_link           lens centre on the board's front face, +X out
                                 through the lens; the rgbd_camera hangs here
       tof_camera_lens_link      the lens front, same axes: Gazebo's cloud frame
       tof_camera_optical_frame  the lens front in the optical convention
                                 (+Z forward, +X right, +Y down) that the
                                 images are stamped in -->
  <xacro:macro name="mobile_base_tof_camera" params="prefix">
    <link name="${prefix}tof_camera_link"/>
    <joint name="${prefix}turret_link_to_tof_camera_link_joint" type="fixed">
      <parent link="${prefix}turret_link"/>
      <child link="${prefix}tof_camera_link"/>
      <origin xyz="${tof_camera_lens_x - tof_camera_lens_depth} 0
                   ${tof_camera_lens_z}" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}tof_camera_lens_link"/>
    <joint name="${prefix}tof_camera_link_to_tof_camera_lens_link_joint"
           type="fixed">
      <parent link="${prefix}tof_camera_link"/>
      <child link="${prefix}tof_camera_lens_link"/>
      <origin xyz="${tof_camera_lens_depth} 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}tof_camera_optical_frame"/>
    <joint name="${prefix}tof_camera_link_to_tof_camera_optical_frame_joint"
           type="fixed">
      <parent link="${prefix}tof_camera_link"/>
      <child link="${prefix}tof_camera_optical_frame"/>
      <origin xyz="${tof_camera_lens_depth} 0 0"
              rpy="${-pi / 2.0} 0 ${-pi / 2.0}"/>
    </joint>
  </xacro:macro>
</robot>
